import socket
def trans_host():
    try:
        Host = input("Enter a Domain:\n")
        s = socket.gethostbyname(Host)
        print(f"The Ip of {Host} is {s}")
    except socket.gaierror:
        print("ERROR in typing or in connect please try again.")
