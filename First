def service_name():
    try:
        port = int(input("Enter a port name :\n"))
        if port > 65535 or port < 0:
            print(f"port must be from 1 to 65535")
            return
        s = socket.getservbyport(port)
        print(f"the service on port {port} is {s}")
    except socket.error:
        print(f"the port {port} is unkown")
def port_scanner_by_hand():
    try:
        host = input("Enter a domain:\n")
        port = int(input("Enter a port:\n"))
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(2)
        sec = s.connect_ex((host, port))
        if sec == 0:
            print(f"[+] port {port} is open")
        else:
            print(f"[-] the port {port} is closed")

    except (socket.error, ValueError):
        print("ERROR in connecting the port or in hostname\nnote\\the port must be from 1 to 65535")

